# Salin ke .env.local untuk `npx vercel dev`, dan isi nilai yang sama di Vercel (Environment Variables).
# Jangan commit .env.local. Berkas ini hanya berisi nama variabel, bukan nilai rahasia.

# Supabase (Project Settings > API). Service role key bersifat rahasia dan hanya dipakai di server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push. Buat dengan `npm run vapid`. VITE_VAPID_PUBLIC_KEY harus sama dengan VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Bot Telegram (opsional).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alamat https aplikasi, untuk tombol "Buka detail" di Telegram. Kosongkan untuk memakai alamat produksi Vercel.
APP_URL=

# PIN opsional. Jika diisi, semua panggilan /api memerlukan header x-app-pin.
APP_PIN=
